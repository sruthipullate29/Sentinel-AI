# ==========================================
# Development Dockerfile with Live HMR
# ==========================================
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

# Expose Vite dev port
EXPOSE 5173

# Run Vite dev server with host 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
